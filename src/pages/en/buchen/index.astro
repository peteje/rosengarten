---
import Layout from '../../../layouts/Layout.astro';
import BookingTool from '../../../components/BookingTool.astro';
---

<Layout title="Book now" description="Check availability and book directly online – all four Villa Rosengarten holiday apartments on Fehmarn.">
  <section class="wrap" style="padding-top:3rem;">
    <h1 class="section-title">Book now</h1>
    <p style="text-align:center; max-width:640px; margin:0 auto 2rem;">
      Check availability and book directly online with instant confirmation –
      for all four Villa Rosengarten holiday apartments.
    </p>

    <BookingTool />

    <p style="text-align:center; margin-top:2rem;">
      Prefer a personal inquiry? <a href="/en/kontakt/">Contact form</a>
    </p>
  </section>
</Layout>
