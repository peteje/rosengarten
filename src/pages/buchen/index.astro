---
import Layout from '../../layouts/Layout.astro';
import BookingTool from '../../components/BookingTool.astro';
---

<Layout title="Jetzt buchen" description="Verfügbarkeit prüfen und direkt online buchen – alle vier Ferienwohnungen der Villa Rosengarten auf Fehmarn.">
  <section class="wrap" style="padding-top:3rem;">
    <h1 class="section-title">Jetzt buchen</h1>
    <p style="text-align:center; max-width:640px; margin:0 auto 2rem;">
      Verfügbarkeit prüfen und mit sofortiger Bestätigung direkt online buchen –
      für alle vier Ferienwohnungen der Villa Rosengarten.
    </p>

    <BookingTool />

    <p style="text-align:center; margin-top:2rem;">
      Lieber eine individuelle Anfrage? <a href="/kontakt/">Kontaktformular</a>
    </p>
  </section>
</Layout>
