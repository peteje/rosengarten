---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Seite nicht gefunden">
  <section class="wrap" style="padding-top:4rem; text-align:center;">
    <h1>Seite nicht gefunden</h1>
    <p>Die aufgerufene Seite existiert leider nicht (mehr).</p>
    <a class="btn" href="/">Zurück zur Startseite</a>
    <hr style="margin:2.5rem auto; max-width:200px; border:none; border-top:1px solid #ddd;" />
    <h1>Page not found</h1>
    <p>Sorry, the page you’re looking for doesn’t exist (anymore).</p>
    <a class="btn" href="/en/">Back to homepage</a>
  </section>
</Layout>
