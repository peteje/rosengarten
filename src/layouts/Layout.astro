---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const lang = Astro.currentLocale === 'en' ? 'en' : 'de';

const defaultDescription =
  lang === 'en'
    ? 'Villa Rosengarten – holiday apartments in Burg on the island of Fehmarn.'
    : 'Villa Rosengarten – Ferienwohnungen in Burg auf Fehmarn.';

const { title, description = defaultDescription } = Astro.props;

// Kanonische URL ohne Query-String (z.B. alte WordPress-Parameter wie
// ?page_id=690, die per .htaccess-Fallback sonst die Startseite ausliefern
// würden) -> sagt Suchmaschinen eindeutig, welche URL die "echte" ist.
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// hreflang-Alternates: die Seitenstruktur unter /en/ spiegelt exakt die
// deutschen Pfade, daher reicht Prefixen/Entfernen von "/en" ohne
// Slug-Übersetzungs-Mapping.
const path = Astro.url.pathname;
const dePath = lang === 'en' ? path.replace(/^\/en(\/|$)/, '/') : path;
const enPath = lang === 'en' ? path : `/en${path}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} · Villa Rosengarten</title>
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="de" href={new URL(dePath, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(enPath, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(dePath, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <noscript>
      <style>
        /* Ohne JavaScript kein Reveal-Observer -> Inhalte direkt sichtbar. */
        .reveal { opacity: 1 !important; transform: none !important; }
      </style>
    </noscript>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <CookieBanner />

    <script>
      // Globales Reveal-on-Scroll: blendet Elemente mit .reveal ein, sobald
      // sie in den Viewport kommen. Läuft auf ALLEN Seiten (auch Galerien auf
      // den Detailseiten). Respektiert prefers-reduced-motion (CSS-Fallback).
      const els = document.querySelectorAll('.reveal');
      if (els.length) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.08 }
        );
        els.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
