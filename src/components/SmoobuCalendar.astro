---
// Bindet den echten Smoobu-Belegungskalender (Single-Calendar-Widget) inline
// ein – identisch zur Einbettung auf der bisherigen Seite rosengarten.casa.
// aptId + verification stammen aus dem Smoobu-Dashboard (pro Wohnung).
//
// Voraussetzung: In public/.htaccess erlaubt die Content-Security-Policy die
// Domain login.smoobu.com (script-src, style-src, connect-src, frame-src,
// font-src) – sonst blockiert der Browser das Widget.
import BookingTool from './BookingTool.astro';
import { localePrefix } from '../i18n/ui.js';

interface Props {
  aptId: string;
  verification: string;
  name: string;
}
const { aptId, verification, name } = Astro.props;
const lang = Astro.currentLocale === 'en' ? 'en' : 'de';
const p = localePrefix(lang);
const loadUrl = `https://login.smoobu.com/${lang}/cockpit/widget/single-calendar/${aptId}`;

const strings =
  lang === 'en'
    ? {
        calendarHeading: `Availability calendar ${name}`,
        calendarLead:
          'Green = available, booked days are marked. To book with instant confirmation, continue directly to our booking portal.',
        bookHeading: `Book ${name} instantly`,
        bookLead: 'Book online directly, with instant confirmation.',
        inquiry: 'Personal inquiry',
      }
    : {
        calendarHeading: `Belegungskalender ${name}`,
        calendarLead:
          'Grün = frei, belegte Tage sind markiert. Für die verbindliche Buchung mit sofortiger Bestätigung geht es direkt weiter zu unserem Buchungsportal.',
        bookHeading: `${name} verbindlich buchen`,
        bookLead: 'Direkt online buchen, mit sofortiger Bestätigung.',
        inquiry: 'Individuelle Anfrage',
      };
---

<section class="booking" id="belegungskalender">
  <h2 class="section-title">{strings.calendarHeading}</h2>
  <p class="section-lead">{strings.calendarLead}</p>

  <div class="smoobu-calendar">
    <div class="calendarWidget" id={`smoobuApartment${aptId}${lang}`}>
      <div
        class="calendarContent"
        data-load-calendar-url={loadUrl}
        data-verification={verification}
        data-baseUrl="https://login.smoobu.com"
        data-disable-css="false"
      ></div>
      <script is:inline type="text/javascript" src="https://login.smoobu.com/js/Apartment/CalendarWidget.js"></script>
    </div>
  </div>

  <h2 class="section-title">{strings.bookHeading}</h2>
  <p class="section-lead">{strings.bookLead}</p>
  <BookingTool apartmentId={aptId} />

  <div class="booking-cta">
    <a class="btn btn-ghost-dark" href={`${p}/kontakt/`}>{strings.inquiry}</a>
  </div>
</section>
