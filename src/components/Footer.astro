---
import { Image } from 'astro:assets';
import ventovinte from '../images/ventovinte-logo.png';
import { t, localePrefix } from '../i18n/ui.js';

const year = new Date().getFullYear();
const lang = Astro.currentLocale === 'en' ? 'en' : 'de';
const f = t(lang).footer;
const p = localePrefix(lang);
---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-top">
      <div class="footer-brand">
        <strong>Villa Rosengarten</strong>
        <p>{f.tagline}<br />{f.amenities}</p>
        <a class="footer-vv-link" href="https://www.ventovinte.com" target="_blank" rel="noopener" aria-label="VentoVinte – Website öffnen">
          <span class="footer-vv-label">{f.offeredBy}</span>
          <Image src={ventovinte} alt="VentoVinte" class="footer-vv" loading="lazy" />
        </a>
      </div>
      <div class="footer-contact">
        <a href="tel:+4943716074284">+49 4371 6074284</a>
        <a href="mailto:info@rosengarten.casa">info@rosengarten.casa</a>
      </div>
    </div>
    <div class="footer-links">
      <a href={`${p}/impressum/`}>{f.impressum}</a>
      <a href={`${p}/datenschutz/`}>{f.datenschutz}</a>
      <a href={`${p}/agb/`}>{f.agb}</a>
      <a href={`${p}/kurtaxe/`}>{f.kurtaxe}</a>
      <a href="https://www.facebook.com/RosengartenFehmarn" target="_blank" rel="noopener">Facebook</a>
      <button type="button" id="footer-cookie-settings" class="footer-link-button">{f.cookieSettings}</button>
    </div>
    <p class="footer-copy">{f.copyright(year)}</p>
  </div>
</footer>

<script>
  // Cookie-Banner erneut einblenden (widerruft nicht sofort, sondern lässt
  // erneut wählen -- Google Analytics bleibt bis zur neuen Entscheidung im
  // aktuellen Zustand, ein Reload nach "Ablehnen" entfernt es beim nächsten
  // Seitenaufruf, da es dann nicht mehr geladen wird).
  document.getElementById('footer-cookie-settings')?.addEventListener('click', () => {
    localStorage.removeItem('rosengarten-cookie-consent');
    document.getElementById('cookie-banner')?.classList.add('show');
  });
</script>
